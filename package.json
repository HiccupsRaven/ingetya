{
  "name": "ingetya",
  "version": "1.0.0-wip.4",
  "description": "Ya inget",
  "main": "dist/server.js",
  "scripts": {
    "start": "node dist/server.js",
    "dev:start": "nodemon backend/server.ts",
    "build": "echo Bundling Frontend && npx --node-options=\"--import tsx\" webpack --disable-interpret --config webpack.prod.ts && echo Compiling Backend && rm -rf ./dist && tsc -p . --extendedDiagnostics && echo Done!",
    "dev:build": "npx --node-options=\"--import tsx\" webpack --disable-interpret --config webpack.dev.ts",
    "test:build": "npx --node-options=\"--import tsx\" webpack --disable-interpret --config webpack.test.ts && rm -rf ./dist && tsc -p . --extendedDiagnostics",
    "server:build": "rm -rf ./dist && tsc -p . --extendedDiagnostics",
    "init": "npx tsx backend/initialBuild.ts",
    "sass:home": "sass --watch ./frontend/stylesheets/home.scss ./public/bundle/home.css --style compressed",
    "sass:app": "sass --watch ./frontend/stylesheets/app.scss ./public/bundle/app.css --style compressed",
    "format": "prettier --write .",
    "check": "prettier --check .",
    "type-check": "tsc -p . --pretty --noEmit",
    "lint": "eslint --ext ts --ext js",
    "up:patch": "npm --no-git-tag-version version patch",
    "up:minor": "npm --no-git-tag-version version minor",
    "up:major": "npm --no-git-tag-version version major",
    "prepatch": "npm --no-git-tag-version version prepatch && npm --no-git-tag-version version prerelease --preid wip",
    "preminor": "npm --no-git-tag-version version preminor && npm --no-git-tag-version version prerelease --preid wip",
    "premajor": "npm --no-git-tag-version version premajor && npm --no-git-tag-version version prerelease --preid wip",
    "prerelease": "npm --no-git-tag-version version prerelease",
    "prepare": "husky"
  },
  "husky": {
    "hooks": {
      "pre-commit": "npx pretty-quick --staged ng lint ng test",
      "pre-push": "ng build --aot true"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HiccupsRaven/ingetya.git"
  },
  "keywords": [],
  "author": "Devanka761 <contact@devanka.id> (https://devanka.id/)",
  "license": "GPL-3.0-or-later",
  "bugs": {
    "url": "https://github.com/HiccupsRaven/ingetya/issues"
  },
  "homepage": "https://github.com/HiccupsRaven/ingetya#readme",
  "dependencies": {
    "connect-mongo": "^6.0.0",
    "dotenv": "^17.2.3",
    "ejs": "^4.0.1",
    "express": "^5.2.1",
    "express-session": "^1.19.0",
    "mongoose": "^9.1.6",
    "webfont-awesome-pro": "1.2.4"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@babel/preset-env": "^7.29.0",
    "@babel/preset-typescript": "^7.28.5",
    "@eslint/js": "^9.39.2",
    "@types/express": "^5.0.6",
    "@types/express-session": "^1.18.2",
    "@types/node": "^25.2.0",
    "@typescript/native-preview": "^7.0.0-dev.20260204.1",
    "babel-loader": "^10.0.0",
    "clean-webpack-plugin": "^4.0.0",
    "css-loader": "^7.1.3",
    "eslint": "^9.39.2",
    "globals": "^17.3.0",
    "html-webpack-plugin": "^5.6.6",
    "mini-css-extract-plugin": "^2.10.0",
    "prettier": "^3.8.1",
    "pretty-quick": "^4.2.2",
    "raw-loader": "^4.0.2",
    "sass": "^1.97.3",
    "sass-loader": "^16.0.6",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.54.0",
    "webpack": "^5.105.0",
    "webpack-cli": "^6.0.1"
  }
}

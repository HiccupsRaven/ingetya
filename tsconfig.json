{
  "compilerOptions": {
    "target": "es2016",
    "module": "commonjs",
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "outDir": "dist",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "noImplicitAny": true,
    "skipLibCheck": true,
    "removeComments": true
  },
  "include": ["backend/**/*"],
  "exclude": ["node_modules/*", "dist/**/*", "public/**/*", "backend/danger/**/*", "webpack*", "backend/initialBuild.ts"]
}
